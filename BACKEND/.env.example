APP_NAME=Aqylman Meeting Protocol API
API_PREFIX=/api/v1
MOCK_MODE=false
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TEXT_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./meeting_protocol.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_MB=25
DEVICE=auto
STT_MODEL_DIR=models/whisper
DIARIZATION_MODEL_DIR=models/diarization
LLM_MODEL_DIR=models/llm
STT_COMPUTE_TYPE=int8
